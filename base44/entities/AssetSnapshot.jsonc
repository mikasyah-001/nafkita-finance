{
  "name": "AssetSnapshot",
  "type": "object",
  "properties": {
    "period": {
      "type": "string"
    },
    "emas_value": {
      "type": "number",
      "default": 0
    },
    "investasi_value": {
      "type": "number",
      "default": 0
    },
    "bank_value": {
      "type": "number",
      "default": 0
    },
    "other_value": {
      "type": "number",
      "default": 0
    },
    "total_value": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "period",
    "total_value"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}