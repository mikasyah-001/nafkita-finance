{
  "name": "Notif Transaksi Pasangan",
  "description": "Membuat notifikasi untuk pasangan saat transaksi bersama dibuat, diperbarui, diubah jangkauannya, atau dihapus",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "Transaction",
      "events": [
        "create",
        "update",
        "delete"
      ]
    },
    "condition": "${ .trigger.data.visibility == \"shared\" or ((.trigger.old_data // {}).visibility == \"shared\") }"
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "notify_partner_transaction",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "notify": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifyPartnerTransaction",
            "args": {
              "transaction_id": "${ .trigger.entity_id }",
              "event_type": "${ .trigger.event_type }",
              "visibility": "${ .trigger.data.visibility }",
              "actor_id": "${ .trigger.data.created_by_id }",
              "tx_type": "${ .trigger.data.type }",
              "amount": "${ .trigger.data.amount }",
              "currency": "${ .trigger.data.currency }",
              "category": "${ .trigger.data.category }",
              "merchant": "${ .trigger.data.merchant }",
              "notes": "${ .trigger.data.notes }",
              "old_visibility": "${ .trigger.old_data.visibility }",
              "created_date": "${ .trigger.data.created_date }",
              "updated_date": "${ .trigger.data.updated_date }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Buat notifikasi pasangan",
            "description": "Transaksi bersama dibuat/diperbarui/dihapus"
          }
        }
      }
    ]
  }
}