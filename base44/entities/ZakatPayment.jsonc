{
  "name": "ZakatPayment",
  "type": "object",
  "properties": {
    "year": {
      "type": "number"
    },
    "zakat_type": {
      "type": "string",
      "enum": [
        "emas",
        "simpanan"
      ],
      "default": "emas"
    },
    "amount": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "unpaid",
        "paid"
      ],
      "default": "unpaid"
    },
    "paid_date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "year",
    "zakat_type",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}