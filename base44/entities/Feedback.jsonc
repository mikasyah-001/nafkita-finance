{
  "name": "Feedback",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "bug",
        "feature",
        "suggestion",
        "other"
      ],
      "default": "suggestion"
    },
    "subject": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "contact": {
      "type": "string"
    },
    "sender_name": { "type": "string", "description": "Nama pengirim saat laporan dibuat" },
    "sender_email": { "type": "string", "description": "Email akun pengirim" },
    "owner_id": { "type": "string", "description": "Id akun pengirim (diisi server)" },
    "owner_email": { "type": "string", "description": "Email akun pengirim (diisi server; dipakai untuk balasan)" },
    "screenshot_url": { "type": "string", "description": "Tangkapan layar (opsional)" },
    "context": {
      "type": "object",
      "description": "Info perangkat & halaman saat melapor (bila pengguna mengizinkan)",
      "properties": {
        "path": { "type": "string" },
        "user_agent": { "type": "string" },
        "platform": { "type": "string" },
        "screen": { "type": "string" },
        "standalone": { "type": "boolean" },
        "online": { "type": "boolean" }
      }
    },
    "admin_reply": { "type": "string", "description": "Balasan admin yang terlihat oleh pengirim" },
    "replied_at": { "type": "string", "format": "date-time" },
    "replied_by_name": { "type": "string" },
    "status_updated_at": { "type": "string", "format": "date-time" },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "in_progress",
        "resolved",
        "closed"
      ],
      "default": "open"
    }
  },
  "required": [
    "type",
    "subject",
    "message"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}