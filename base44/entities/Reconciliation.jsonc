{
  "name": "Reconciliation",
  "type": "object",
  "properties": {
    "asset_id": {
      "type": "string",
      "description": "ID aset bank yang direkonsiliasi"
    },
    "asset_name": {
      "type": "string",
      "description": "Nama aset saat rekonsiliasi (snapshot)"
    },
    "statement_balance": {
      "type": "number",
      "description": "Saldo per ekstrak rekening/statement yang dimasukkan pengguna"
    },
    "computed_balance": {
      "type": "number",
      "description": "Saldo terhitung dari mutasi transaksi terkait aset sampai as_of_date"
    },
    "difference": {
      "type": "number",
      "description": "Selisih: statement_balance - computed_balance"
    },
    "currency": {
      "type": "string",
      "default": "IDR"
    },
    "as_of_date": {
      "type": "string",
      "format": "date",
      "description": "Tanggal perhitungan rekonsiliasi"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "reconciled"
      ],
      "default": "open"
    },
    "adjustment_tx_id": {
      "type": "string",
      "description": "ID transaksi penyesuaian yang dibuat untuk menutup selisih (opsional)"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "asset_id",
    "statement_balance",
    "as_of_date"
  ],
  "rls": {
    "create": null,
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.visibility": {
                "$ne": "private"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}