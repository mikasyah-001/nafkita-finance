{
  "name": "Asset",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "bank",
        "tunai",
        "emas",
        "emas_digital",
        "investasi",
        "properti",
        "tanah",
        "lainnya"
      ],
      "default": "bank"
    },
    "value": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "default": "IDR",
      "description": "Kode mata uang (IDR/SAR/USD bawaan, atau mata uang kustom pengguna)"
    },
    "quantity": {
      "type": "number"
    },
    "unit": {
      "type": "string"
    },
    "broker": {
      "type": "string",
      "description": "Tempat pembelian/penyimpanan (mis. Bank Al Rajhi, Bank BSI, BCA)"
    },
    "account_number": {
      "type": "string",
      "description": "No. rekening / IBAN untuk Tabungan/Bank (tanpa spasi). Satu bank bisa punya beberapa rekening."
    },
    "purchase_date": {
      "type": "string",
      "format": "date"
    },
    "purchase_price": {
      "type": "number"
    },
    "purchase_proof_url": {
      "type": "string"
    },
    "owner": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "ticker": {
      "type": "string",
      "description": "Kode efek/instrumen (mis. 1120, 2222, SPUS) — kunci pencocokan saat impor ulang portofolio"
    },
    "exchange": {
      "type": "string",
      "description": "Bursa efek (mis. TASI, ARCA) — menentukan sumber harga resmi"
    },
    "instrument": {
      "type": "string",
      "enum": ["saham", "reksadana", "pasar_uang", "etf", "sukuk", "lainnya"],
      "description": "Jenis instrumen untuk aset investasi (ditebak otomatis bila kosong)"
    },
    "instrument_manual": {
      "type": "boolean",
      "description": "true bila jenis instrumen dipilih sendiri oleh pengguna (tebakan otomatis tidak menimpa)"
    },
    "last_price": {
      "type": "number",
      "description": "Harga terakhir per unit (mata uang aset) saat impor/pembaruan"
    },
    "price_date": {
      "type": "string",
      "format": "date",
      "description": "Tanggal harga/nilai pasar terakhir"
    },
    "value_source": {
      "type": "string",
      "enum": ["broker", "online", "manual"],
      "description": "Asal nilai pasar terakhir: broker (impor dari aplikasi tempat beli — utama), online (perkiraan harga internet), manual"
    },
    "import_source": {
      "type": "string",
      "description": "Asal data bila diimpor, mis. 'Al Rajhi Capital · foto'"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "shared",
        "private"
      ],
      "default": "shared"
    }
  },
  "required": [
    "name",
    "type",
    "value"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.visibility": {
                "$ne": "private"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}