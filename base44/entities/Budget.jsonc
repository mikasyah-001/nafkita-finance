{
  "name": "Budget",
  "type": "object",
  "properties": {
    "category": {
      "type": "string"
    },
    "limit_amount": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "enum": [
        "IDR",
        "SAR",
        "USD"
      ],
      "default": "IDR"
    },
    "period": {
      "type": "string"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "shared",
        "private"
      ],
      "default": "shared"
    }
  },
  "required": [
    "category",
    "limit_amount",
    "period"
  ],
  "rls": {
    "create": null,
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.visibility": {
                "$ne": "private"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}