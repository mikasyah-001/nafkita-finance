{
  "name": "Partnership",
  "type": "object",
  "properties": {
    "inviter_id": {
      "type": "string",
      "description": "ID user yang mengundang"
    },
    "invitee_email": {
      "type": "string",
      "description": "Email pasangan yang diundang"
    },
    "invitee_id": {
      "type": "string",
      "description": "ID user pasangan setelah menerima undangan"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "active",
        "declined",
        "cancelled",
        "ended"
      ],
      "default": "pending"
    },
    "inviter_role": {
      "type": "string",
      "enum": [
        "suami",
        "istri"
      ],
      "description": "Peran pengundang (dipilih saat membuat undangan)"
    },
    "invitee_role": {
      "type": "string",
      "enum": [
        "suami",
        "istri"
      ],
      "description": "Peran penerima (otomatis pelengkap dari inviter_role)"
    },
    "ended_at": {
      "type": "string",
      "format": "date-time",
      "description": "Waktu hubungan berakhir/dibatalkan/ditolak"
    },
    "ended_by": {
      "type": "string",
      "description": "ID user/aktor yang mengakhiri (atau 'system' untuk auto-cancel)"
    },
    "end_reason": {
      "type": "string",
      "description": "Alasan pengakhiran singkat (opsional)"
    }
  },
  "required": [
    "inviter_id",
    "invitee_email",
    "status"
  ],
  "rls": {
    "create": null,
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.invitee_email": "{{user.email}}"
        },
        {
          "data.invitee_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}