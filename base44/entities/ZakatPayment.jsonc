{
  "name": "ZakatPayment",
  "type": "object",
  "properties": {
    "year": {
      "type": "number"
    },
    "zakat_type": {
      "type": "string",
      "enum": [
        "emas",
        "simpanan",
        "mal"
      ],
      "default": "mal",
      "description": "mal = zakat mal gabungan (dipakai sejak perbaikan perhitungan); emas/simpanan = data lama"
    },
    "amount": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "unpaid",
        "paid"
      ],
      "default": "unpaid"
    },
    "currency": {
      "type": "string",
      "default": "IDR"
    },
    "period_key": {
      "type": "string",
      "description": "Kunci periode haul, mis. haul-2026-01-01 atau H1448"
    },
    "transaction_id": {
      "type": "string",
      "description": "Transaksi sedekah/zakat yang tercatat saat pembayaran"
    },
    "notes": {
      "type": "string"
    },
    "amount_idr": {
      "type": "number",
      "description": "Nominal setara IDR saat dibayar (zakat dihitung dalam IDR; pembayaran boleh SAR/mata uang lain)"
    },
    "paid_date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "year",
    "zakat_type",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}