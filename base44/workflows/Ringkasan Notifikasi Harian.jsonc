{
  "name": "Ringkasan Notifikasi Harian",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 21 * * *",
      "one_time_date": null,
      "timezone": "Asia/Riyadh",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Mengirim email ringkasan harian pukul 21:00 kepada pengguna yang memilih daily_digest, berisi transaksi & aset bersama dari pasangan hari ini",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "notification_digest",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "send_digest": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notificationDigest",
            "args": {
              "token": "nafkita-wf-8f3a2c7e9b1d4e6f"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Kirim ringkasan harian",
            "description": "Email ringkasan ke pengguna daily_digest"
          }
        }
      }
    ]
  }
}