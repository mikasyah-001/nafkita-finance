{
  "name": "SavingsGoal",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nama target tabungan (mis. Dana Darurat, Biaya Pendidikan Anak)"
    },
    "type": {
      "type": "string",
      "enum": [
        "darurat",
        "pendidikan",
        "rumah",
        "perjalanan",
        "lainnya"
      ],
      "default": "lainnya"
    },
    "target_amount": {
      "type": "number",
      "description": "Nominal target yang ingin dicapai"
    },
    "current_amount": {
      "type": "number",
      "default": 0,
      "description": "Akumulasi tabungan saat ini"
    },
    "currency": {
      "type": "string",
      "default": "IDR"
    },
    "target_date": {
      "type": "string",
      "format": "date",
      "description": "Tanggal target pencapaian"
    },
    "linked_asset_id": {
      "type": "string",
      "description": "ID aset bank sumber untuk top-up"
    },
    "icon": {
      "type": "string",
      "default": "PiggyBank"
    },
    "color": {
      "type": "string",
      "default": "green"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "shared",
        "private"
      ],
      "default": "shared"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "completed",
        "cancelled"
      ],
      "default": "active"
    },
    "contribution_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date-time"
          },
          "amount": {
            "type": "number"
          },
          "method": {
            "type": "string",
            "enum": [
              "manual",
              "topup"
            ]
          },
          "source_tx_id": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      },
      "default": []
    }
  },
  "required": [
    "name",
    "type",
    "target_amount",
    "current_amount"
  ],
  "rls": {
    "create": null,
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.visibility": {
                "$ne": "private"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}