{
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ],
      "default": "user"
    },
    "photo_url": {
      "type": "string",
      "format": "uri",
      "description": "URL foto profil pengguna"
    },
    "default_currency": {
      "type": "string",
      "default": "IDR",
      "description": "Mata uang utama pengguna untuk tampilan default"
    },
    "active_currencies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [
        "IDR"
      ],
      "description": "Daftar kode mata uang yang diaktifkan pengguna (bawaan maupun kustom)"
    },
    "custom_currencies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "Kode mata uang unik (mis. EUR, MYR)"
          },
          "label": {
            "type": "string",
            "description": "Nama mata uang untuk ditampilkan"
          },
          "symbol": {
            "type": "string",
            "description": "Simbol/awalan nominal (mis. \u20ac, RM)"
          }
        },
        "required": [
          "code",
          "label",
          "symbol"
        ]
      },
      "default": [],
      "description": "Mata uang kustom yang dibuat pengguna di luar katalog bawaan"
    },
    "onboarding_completed": {
      "type": "boolean",
      "default": false,
      "description": "Apakah onboarding awal sudah selesai"
    },
    "timezone": {
      "type": "string",
      "description": "Zona waktu IANA pengguna (mis. Asia/Riyadh), terdeteksi otomatis dari browser"
    },
    "reminder_hour": {
      "type": "number",
      "default": 20,
      "minimum": 0,
      "maximum": 23,
      "description": "Jam lokal (0-23) untuk mengirim email pengingat harian"
    },
    "last_active_at": {
      "type": "string",
      "format": "date-time",
      "description": "Waktu aktivitas terakhir pengguna (heartbeat), dasar perhitungan user aktif real-time"
    },
    "projection_assumptions": {
      "type": "object",
      "description": "Asumi proyeksi keuangan pengguna",
      "properties": {
        "monthly_income_growth": {
          "type": "number",
          "default": 0,
          "description": "Pertumbuhan pemasukan bulanan (persen)"
        },
        "monthly_expense_growth": {
          "type": "number",
          "default": 0,
          "description": "Pertumbuhan pengeluaran bulanan (persen)"
        },
        "months_ahead": {
          "type": "number",
          "default": 6,
          "description": "Jumlah bulan ke depan untuk forecast"
        }
      }
    }
  },
  "required": [
    "role"
  ],
  "name": "User",
  "type": "object"
}