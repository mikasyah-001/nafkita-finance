{
  "name": "Transaction",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "income",
        "expense",
        "sedekah"
      ],
      "default": "expense"
    },
    "amount": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "default": "IDR",
      "description": "Kode mata uang (IDR/SAR/USD bawaan, atau mata uang kustom pengguna)"
    },
    "category": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date-time"
    },
    "merchant": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "photo_url": {
      "type": "string"
    },
    "input_by_name": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "visibility": {
      "type": "string",
      "enum": [
        "shared",
        "private"
      ],
      "default": "shared"
    },
    "linked_asset_id": {
      "type": "string",
      "description": "ID aset bank yang saldonya disesuaikan otomatis saat transaksi ini dibuat/diubah/dihapus"
    },
    "notif_batch_id": {
      "type": "string",
      "description": "Flag internal: bila diisi, notifikasi individual dilewati (impor/scan/sample data)"
    },
    "transfer_pair_id": {
      "type": "string",
      "description": "ID pasangan transfer \u2014 menghubungkan dua record transfer (asal \u2194 tujuan). Bila diisi, transaksi diexclude dari ringkasan pemasukan/pengeluaran"
    },
    "transfer_direction": {
      "type": "string",
      "enum": [
        "in",
        "out"
      ],
      "description": "Arah transfer: out = dari rekening asal, in = ke rekening tujuan"
    },
    "recurring_id": {
      "type": "string",
      "description": "ID tagihan berulang yang menghasilkan transaksi ini secara otomatis"
    },
    "is_adjustment": {
      "type": "boolean",
      "default": false,
      "description": "True bila transaksi ini adalah penyesuaian rekonsiliasi saldo rekening"
    },
    "approval_status": {
      "type": "string",
      "enum": [
        "approved",
        "pending",
        "rejected"
      ],
      "default": "approved",
      "description": "Status persetujuan: approved = transaksi normal, pending = menunggu persetujuan pasangan (aset belum disesuaikan), rejected = ditolak pasangan"
    },
    "approval_id": {
      "type": "string",
      "description": "ID TransactionApproval terkait (bila status pending/rejected)"
    }
  },
  "required": [
    "type",
    "amount",
    "category",
    "date"
  ],
  "rls": {
    "create": null,
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.visibility": {
                "$ne": "private"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}