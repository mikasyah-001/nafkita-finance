{
  "name": "AssetSnapshot",
  "type": "object",
  "properties": {
    "owner_id": {
      "type": "string",
      "description": "ID user pemilik snapshot (dihimpun oleh backend)"
    },
    "currency": {
      "type": "string",
      "default": "IDR",
      "description": "Kode mata uang (IDR/SAR/USD bawaan, atau mata uang kustom pengguna)"
    },
    "period": {
      "type": "string"
    },
    "scope": {
      "type": "string",
      "enum": [
        "own",
        "family"
      ],
      "default": "family",
      "description": "own = hanya aset milik sendiri; family = termasuk aset shared pasangan"
    },
    "emas_value": {
      "type": "number",
      "default": 0
    },
    "investasi_value": {
      "type": "number",
      "default": 0
    },
    "bank_value": {
      "type": "number",
      "default": 0
    },
    "other_value": {
      "type": "number",
      "default": 0
    },
    "total_value": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "period",
    "total_value"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}