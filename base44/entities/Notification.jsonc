{
  "name": "Notification",
  "type": "object",
  "properties": {
    "target_user_id": {
      "type": "string",
      "description": "ID user penerima notifikasi"
    },
    "actor_name": {
      "type": "string",
      "description": "Nama pasangan yang melakukan aksi"
    },
    "action": {
      "type": "string",
      "enum": [
        "created",
        "updated",
        "deleted",
        "shared",
        "unshared",
        "bulk",
        "accepted",
        "declined",
        "cancelled",
        "terminated"
      ],
      "default": "created"
    },
    "entity_kind": {
      "type": "string",
      "enum": [
        "transaction",
        "asset",
        "bulk",
        "partnership"
      ],
      "default": "transaction"
    },
    "event_key": {
      "type": "string",
      "description": "Kunci idempotensi \u2014 mencegah notifikasi duplikat saat workflow di-retry"
    },
    "title": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "ref_id": {
      "type": "string",
      "description": "ID entitas terkait (transaksi/aset/partnership)"
    },
    "amount": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "default": "IDR",
      "description": "Mata uang nominal transaksi/aset (disinkronkan dari entitas sumber)"
    },
    "tx_type": {
      "type": "string"
    },
    "read": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "target_user_id",
    "action",
    "title",
    "read"
  ],
  "rls": {
    "read": {
      "data.target_user_id": "{{user.id}}"
    },
    "update": {
      "data.target_user_id": "{{user.id}}"
    },
    "delete": {
      "data.target_user_id": "{{user.id}}"
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}