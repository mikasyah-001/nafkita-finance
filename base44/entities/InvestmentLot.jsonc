{
  "name": "InvestmentLot",
  "type": "object",
  "properties": {
    "asset_id": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "price_per_unit": {
      "type": "number"
    },
    "quantity": {
      "type": "number"
    },
    "amount": {
      "type": "number"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "asset_id",
    "date",
    "price_per_unit",
    "quantity"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}