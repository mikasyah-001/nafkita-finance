{
  "name": "TransactionApproval",
  "type": "object",
  "properties": {
    "transaction_id": {
      "type": "string",
      "description": "ID transaksi yang memerlukan persetujuan"
    },
    "requester_id": {
      "type": "string",
      "description": "ID user pembuat transaksi"
    },
    "requester_name": {
      "type": "string",
      "description": "Nama user pembuat transaksi"
    },
    "approver_id": {
      "type": "string",
      "description": "ID user pasangan yang harus menyetujui"
    },
    "approver_name": {
      "type": "string",
      "description": "Nama user pasangan"
    },
    "amount": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "default": "IDR"
    },
    "category": {
      "type": "string"
    },
    "merchant": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "cancelled"
      ],
      "default": "pending"
    },
    "threshold_at_request": {
      "type": "number",
      "description": "Ambang persetujuan saat transaksi dibuat"
    },
    "requested_at": {
      "type": "string",
      "format": "date-time"
    },
    "decided_at": {
      "type": "string",
      "format": "date-time"
    },
    "rejection_reason": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "transaction_id",
    "requester_id",
    "approver_id",
    "amount",
    "status"
  ],
  "rls": {
    "create": null,
    "read": {
      "$or": [
        {
          "data.requester_id": "{{user.id}}"
        },
        {
          "data.approver_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}