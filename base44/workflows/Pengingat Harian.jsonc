{
  "name": "Pengingat Harian",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 20 * * *",
      "one_time_date": null,
      "timezone": "Asia/Jakarta",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Mengirim email pengingat harian pukul 20:00 kepada anggota keluarga yang belum mencatat transaksi hari ini",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_reminder",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "send_reminder": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "dailyReminder"
          },
          "then": "end",
          "x-base44": {
            "title": "Kirim pengingat harian",
            "description": "Email ke yang belum mencatat"
          }
        }
      }
    ]
  }
}