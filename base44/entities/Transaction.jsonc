{
  "name": "Transaction",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "income",
        "expense",
        "sedekah"
      ],
      "default": "expense"
    },
    "amount": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "enum": [
        "IDR",
        "SAR",
        "USD"
      ],
      "default": "IDR"
    },
    "category": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date-time"
    },
    "merchant": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "photo_url": {
      "type": "string"
    },
    "input_by_name": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "visibility": {
      "type": "string",
      "enum": [
        "shared",
        "private"
      ],
      "default": "shared"
    },
    "linked_asset_id": {
      "type": "string",
      "description": "ID aset bank yang saldonya disesuaikan otomatis saat transaksi ini dibuat/diubah/dihapus"
    },
    "notif_batch_id": {
      "type": "string",
      "description": "Flag internal: bila diisi, notifikasi individual dilewati (impor/scan/sample data)"
    }
  },
  "required": [
    "type",
    "amount",
    "category",
    "date"
  ],
  "rls": {
    "create": null,
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.visibility": {
                "$ne": "private"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}