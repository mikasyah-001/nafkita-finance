{
  "name": "InvestmentLot",
  "type": "object",
  "properties": {
    "asset_id": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "price_per_unit": {
      "type": "number"
    },
    "quantity": {
      "type": "number"
    },
    "amount": {
      "type": "number"
    },
    "notes": {
      "type": "string"
    },
    "side": {
      "type": "string",
      "enum": ["buy", "sell"],
      "default": "buy",
      "description": "Beli atau jual"
    },
    "source": {
      "type": "string",
      "enum": ["manual", "import"],
      "default": "manual",
      "description": "manual = dicatat di halaman DCA; import = dari screenshot/PDF broker"
    }
  },
  "required": [
    "asset_id",
    "date",
    "price_per_unit",
    "quantity"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}