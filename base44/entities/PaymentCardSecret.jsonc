{
  "name": "PaymentCardSecret",
  "type": "object",
  "properties": {
    "owner_id": {
      "type": "string"
    },
    "card_id": {
      "type": "string"
    },
    "exp_month": {
      "type": "number"
    },
    "exp_year": {
      "type": "number"
    },
    "holder_name": {
      "type": "string"
    },
    "photo_uri": {
      "type": "string",
      "description": "File privat (UploadPrivateFile); dibuka lewat signed URL singkat setelah PIN"
    }
  },
  "required": [
    "owner_id",
    "card_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
