  },
  "description": "Mengirim ringkasan laporan keuangan bulanan ke email user dan pasangan setiap tanggal 1 pukul 08:00 untuk meninjau anggaran bersama",
  "definition": {
    "document": {
      "dsl": "1.0.0",
